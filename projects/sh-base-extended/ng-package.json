{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/sh-base-extended",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    { "input": "src/lib/styles", "glob": "**/*.scss", "output": "styles" },
    { "input": "src/lib/core/styles", "glob": "_sh-mixins.scss", "output": "styles" },
    { "input": "src/lib/assets", "glob": "**/*", "output": "assets" }
  ]
}
